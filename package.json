{
  "name": "atrium-studio",
  "private": true,
  "version": "1.3.2",
  "description": "Privacy-first Liquid Glass roleplay chat studio for Ollama and OpenAI-compatible APIs.",
  "author": "Miko",
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:exe": "node scripts/generate-ico.cjs && vite build && electron-builder --win portable nsis",
    "build:linux": "vite build && electron-builder --linux AppImage",
    "build:mac": "vite build && electron-builder --mac dmg",
    "preview": "vite preview",
    "clean": "rm -rf dist release",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  },
  "build": {
    "appId": "com.atrium.roleplay",
    "productName": "Atrium",
    "copyright": "Copyright © 2026 Miko. All rights reserved.",
    "asar": true,
    "icon": "build/icon.png",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Atrium-Portable-${version}.${ext}"
    },
    "nsis": {
      "artifactName": "Atrium-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "artifactName": "Atrium-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "artifactName": "Atrium-${version}.${ext}"
    }
  }
}
